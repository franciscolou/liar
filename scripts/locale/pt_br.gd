	"BACK TO LOBBY": "VOLTAR AO LOBBY",
	"Only the host can deal again.": "Só o anfitrião pode dar as cartas de novo.",
	"SETTINGS": "CONFIGURAÇÕES",
	"Settings": "Configurações",
	"Music": "Música",
