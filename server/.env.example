# The domain pointing at the VPS (an A record), for HTTPS. The game is told
# https://<this domain> (RankedApi.DEFAULT_URL).
LIAR_DOMAIN=liar.example.com
# What the game connects to for the match servers: the same domain, or the
# VPS's public IP.
LIAR_PUBLIC_HOST=liar.example.com
# UDP ports of the match servers, one per table (open them in the firewall,
# and keep docker-compose.yml in step).
LIAR_PORT_FIRST=24600
LIAR_PORT_COUNT=32
# Ranked tables: how many sit, and how long the first in the queue waits for
# a full table before a smaller one is dealt (seconds).
LIAR_MIN_PLAYERS=3
LIAR_MAX_PLAYERS=5
LIAR_FILL_AFTER=45
# How long a table waits for everyone to sit down, and a seat for a player
# who dropped out before a bot plays it (seconds).
LIAR_ARRIVE_SECONDS=60
LIAR_AWAY_SECONDS=60
# A ranked room (hosted by a player): once the first member reports the end
# of a match, how long the others get to report theirs (seconds).
LIAR_ROOM_SETTLE=90
